              <h1 class="mb-4"><%= title %></h1>

              <div class="bg-light p-5 rounded shadow" style="max-width: 500px;">
                  <p class="mb-0">  Este site foi desenvolvido com o objetivo de praticar e demonstrar conhecimentos em desenvolvimento web, utilizando tecnologias como <a href="https://nodejs.org/" target="_blank" rel="noopener noreferrer">Node.js</a>, <a href="https://expressjs.com/" target="_blank" rel="noopener noreferrer">Express</a> e <a href="https://getbootstrap.com/" target="_blank" rel="noopener noreferrer">Bootstrap</a>.</p>
              </div>

          </div>
  </main>


    <%- include('partials/footer') %>

  </body>
</html>
